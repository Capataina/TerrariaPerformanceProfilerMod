<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\tModLoader.targets" />
  <PropertyGroup>
    <AssemblyName>PerformanceProfiler</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Exclude the non-shipping Tests/ project from the main mod build. The
    test files Compile Include the pure-logic sources via Link from their
    own .csproj; including them here would pull xUnit attributes and types
    that the mod runtime can't resolve. Also keeps the test .csproj itself
    from being discovered as a sub-project.
  -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Tests\**\*" />
    <Content Remove="Tests\**\*" />
  </ItemGroup>

  <!--
    v0.9.0: in-game overlay archived. The browser dashboard (Web/) is the
    only player surface; the UI/Overlay/ and UI/ProfilerOverlay.cs sources
    stay on disk so a future variant (Steam Deck handheld mode, secondary
    overlay) can resurrect them by removing this exclusion. Until then
    they're excluded from compilation so the mod doesn't carry dead code
    into runtime.
  -->
  <ItemGroup>
    <Compile Remove="UI\Overlay\**\*.cs" />
    <Compile Remove="UI\ProfilerOverlay.cs" />
  </ItemGroup>

  <!--
    LiteDB 5.0.21 — single-file managed embedded DB. Shipped inside the .tmod
    so the mod is self-contained; build.txt's `dllReferences = LiteDB` tells
    tModLoader to pack the assembly and load it before the mod assembly runs.
    PrivateAssets=all keeps the package from leaking into consumers (n/a for
    a mod but the right hygiene).
  -->
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" PrivateAssets="all" />
  </ItemGroup>
</Project>
