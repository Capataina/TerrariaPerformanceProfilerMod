<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Non-shipping test harness for pure-logic surfaces (ranking, insight
    promotion, ring buffers, etc.). Lives inside the mod source folder so the
    tests stay next to the code, but is deliberately excluded from the .tmod
    package via build.txt's buildIgnore and from the main project's Compile
    glob via PerformanceProfiler.csproj.

    Run with:
        dotnet test Tests/PerformanceProfiler.Tests.csproj

    This project does NOT import tModLoader.targets — tests only exercise
    pure helpers that have no tModLoader runtime dependency. The handful
    of source files we need are linked in via Compile Include below; we
    deliberately avoid a ProjectReference to the mod project because that
    would drag tModLoader assemblies into the test runner.

    Linked-source paths track the v0.10/v0.11 reorganisation that moved every
    stream-shaped class from Profiling/ into Data/. When you add a test fixture
    for a new pure-logic source file, add the file to the Compile Include list
    at its current Data/ or Profiling/ location AND ensure that file genuinely
    has no Terraria.ModLoader references. If it does, mock the dependency or
    test a lower-level helper instead.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>PerformanceProfiler.Tests</RootNamespace>
    <!-- Don't auto-include parent-directory .cs files; we curate the list below. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- LiteDB shipped via the mod's lib folder; reference the same assembly
         that ships inside the .tmod so the test harness exercises the
         production DLL. -->
    <Reference Include="LiteDB">
      <HintPath>..\lib\LiteDB.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Test files in this folder (includes the folded-in
         HookInstallRetentionDiagnostics.cs — pure System/Xunit, no mod deps). -->
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure-logic source files lifted in from the mod project. Each entry's
         file must have zero Terraria.ModLoader dependencies (verified per add).
         v0.10/v0.11 moved the stream-shaped classes Profiling/ -> Data/; paths
         below point at the current locations (the Events bitsets / flags /
         invasion / boss / mode files stayed in Profiling/Events/). -->
    <Compile Include="..\Profiling\RingBuffer.cs" Link="Source\RingBuffer.cs" />
    <Compile Include="..\Data\Aggregators\PerModSample.cs" Link="Source\PerModSample.cs" />
    <Compile Include="..\Data\Aggregators\PerModAttribution.cs" Link="Source\PerModAttribution.cs" />
    <Compile Include="..\Profiling\TickFrame.cs" Link="Source\TickFrame.cs" />
    <Compile Include="..\Data\Stats\Baseline.cs" Link="Source\Baseline.cs" />
    <Compile Include="..\Data\Detectors\StallDetector.cs" Link="Source\StallDetector.cs" />
    <!-- 2026-07-07 honesty pass + e2e Ring 1 (the scenario engine in
         Tests/Simulation/ drives the REAL detector/stat classes): the spike
         detector + its per-tick ring, the decomposed KPI fold, the realtime-
         speed maths, the pure heatmap fold, and the sustained-slowness core.
         All verified Terraria-free per the rule above. -->
    <Compile Include="..\Data\Detectors\SpikeDetector.cs" Link="Source\SpikeDetector.cs" />
    <Compile Include="..\Data\Aggregators\PerTickAttributionRing.cs" Link="Source\PerTickAttributionRing.cs" />
    <Compile Include="..\Data\Stats\KpiSnapshot.cs" Link="Source\KpiSnapshot.cs" />
    <Compile Include="..\Data\Stats\KpiCalculator.cs" Link="Source\KpiCalculator.cs" />
    <Compile Include="..\Data\Stats\RealtimeSpeed.cs" Link="Source\RealtimeSpeed.cs" />
    <Compile Include="..\Data\Aggregators\HeatmapFold.cs" Link="Source\HeatmapFold.cs" />
    <Compile Include="..\Insights\Detectors\SustainedSlownessCore.cs" Link="Source\Insights\Detectors\SustainedSlownessCore.cs" />
    <Compile Include="..\Insights\Detectors\DrawBoundModCore.cs" Link="Source\Insights\Detectors\DrawBoundModCore.cs" />
    <Compile Include="..\Profiling\Events\BiomeBitset.cs" Link="Source\Events\BiomeBitset.cs" />
    <Compile Include="..\Profiling\Events\WeatherFlags.cs" Link="Source\Events\WeatherFlags.cs" />
    <Compile Include="..\Profiling\Events\InvasionId.cs" Link="Source\Events\InvasionId.cs" />
    <Compile Include="..\Profiling\Events\GameMode.cs" Link="Source\Events\GameMode.cs" />
    <Compile Include="..\Profiling\Events\BossSlotArray.cs" Link="Source\Events\BossSlotArray.cs" />
    <Compile Include="..\Profiling\Events\EventContext.cs" Link="Source\Events\EventContext.cs" />
    <Compile Include="..\Insights\Insight.cs" Link="Source\Insights\Insight.cs" />
    <Compile Include="..\Insights\InsightConstants.cs" Link="Source\Insights\InsightConstants.cs" />
    <Compile Include="..\Insights\InsightStore.cs" Link="Source\Insights\InsightStore.cs" />
    <Compile Include="..\Insights\RankingScorer.cs" Link="Source\Insights\RankingScorer.cs" />
    <!-- Pure detector cores: the concentration / hot-hook math lifted out of the
         MetricCollector-coupled detectors so the lever-naming and absolute-cost floors
         are unit-testable against synthetic arrays (no game runtime). -->
    <Compile Include="..\Insights\Detectors\CostConcentrationCore.cs" Link="Source\Insights\Detectors\CostConcentrationCore.cs" />
    <Compile Include="..\Insights\Detectors\HotHookDominanceCore.cs" Link="Source\Insights\Detectors\HotHookDominanceCore.cs" />
    <!-- Wave 1 Shared primitives (pure math over the pure RolloutContracts
         entry types); the L1 axis of context/plans/extensive-testing-infrastructure.md
         guards their byte-identical contract for the waves that follow. -->
    <Compile Include="..\Data\Contracts\RolloutContracts.cs" Link="Source\Contracts\RolloutContracts.cs" />
    <Compile Include="..\Insights\Shared\ModMetrics.cs" Link="Source\Insights\Shared\ModMetrics.cs" />
    <Compile Include="..\Insights\Shared\Shares.cs" Link="Source\Insights\Shared\Shares.cs" />
    <Compile Include="..\Insights\Shared\ModNames.cs" Link="Source\Insights\Shared\ModNames.cs" />
    <!-- Wave 3 reference-frame substrate (pure stats + the per-context accumulator). -->
    <Compile Include="..\Insights\Shared\Stats.cs" Link="Source\Insights\Shared\Stats.cs" />
    <Compile Include="..\Insights\ReferenceFrames\ContextBaseline.cs" Link="Source\Insights\ReferenceFrames\ContextBaseline.cs" />
    <!-- CrossSessionStore moved into the top-level Persistence/ folder; it is now
         covered by the ..\Persistence\*.cs glob below, not included explicitly here. -->
    <!-- Wave 5 family B substrate: the early/late temporal baseline + the driver contracts. -->
    <Compile Include="..\Insights\Contracts\IInsightInput.cs" Link="Source\Insights\Contracts\IInsightInput.cs" />
    <Compile Include="..\Insights\Contracts\IDriver.cs" Link="Source\Insights\Contracts\IDriver.cs" />
    <Compile Include="..\Insights\Drivers\Drivers.cs" Link="Source\Insights\Drivers\Drivers.cs" />
    <Compile Include="..\Insights\ReferenceFrames\TemporalBaseline.cs" Link="Source\Insights\ReferenceFrames\TemporalBaseline.cs" />
    <!-- DB rework wave 4: the cross-session detector family is Terraria-free (it reads the
         persisted HistoryStore types, not MetricCollector), so the cross-session reasoning
         is unit-tested against synthetic histories. Insight.cs is already linked above. -->
    <Compile Include="..\Insights\CrossSession\*.cs" Link="Source\Insights\CrossSession\%(Filename)%(Extension)" />

    <!-- v0.6 Phase alpha shared infrastructure. LangNameCache and ModOwnerCache
         depend on Terraria.ModLoader so they are NOT lifted; their verification
         is via in-game playtest at wrap-up. The runtime-independent helpers
         (Time, RowPool, ListPool, BoolIndex, EnumStringTable) get exercised
         by xUnit so the per-tick zero-alloc contract is testable. -->
    <Compile Include="..\Profiling\Time.cs" Link="Source\Time.cs" />
    <Compile Include="..\Profiling\Pools\IPoolReset.cs" Link="Source\Pools\IPoolReset.cs" />
    <Compile Include="..\Profiling\Pools\RowPool.cs" Link="Source\Pools\RowPool.cs" />
    <Compile Include="..\Profiling\Pools\ListPool.cs" Link="Source\Pools\ListPool.cs" />
    <Compile Include="..\Profiling\Util\BoolIndex.cs" Link="Source\Util\BoolIndex.cs" />
    <Compile Include="..\Profiling\EnumStringTable.cs" Link="Source\EnumStringTable.cs" />

    <!-- Persistence sources. The whole memory layer lives under the top-level
         Persistence/ folder: ProfilerDatabase, records, writer, journal,
         CrossSessionStore, and the per-collection STREAM classes under Streams/.
         ProfilerDatabase references StreamRegistry, so Streams/ must be linked.
         All reference LiteDB only (no tModLoader); the streams' inert
         Data.Collectors / Data.Aggregators.Segments header usings resolve
         against the empty stubs in _TestNamespaceStubs.cs. -->
    <Compile Include="..\Persistence\*.cs" Link="Source\Persistence\%(Filename)%(Extension)" />
    <Compile Include="..\Persistence\Records\*.cs" Link="Source\Persistence\Records\%(Filename)%(Extension)" />
    <Compile Include="..\Persistence\Streams\*.cs" Link="Source\Streams\%(Filename)%(Extension)" />
    <!-- Wave 1 cross-session rollup: the pure fold (RollupFold) + its DTO + the read
         layer (HistoryStore) are runtime-free and unit-tested against synthetic rows. -->
    <Compile Include="..\Persistence\History\*.cs" Link="Source\History\%(Filename)%(Extension)" />
    <!-- Wave 3 lifecycle: modlist-change diff (pure) + the reset logic (over the public
         collections), unit-tested against a synthetic store. -->
    <Compile Include="..\Persistence\Lifecycle\*.cs" Link="Source\Lifecycle\%(Filename)%(Extension)" />
    <!-- Files that reference Terraria types must be excluded from the
         test compile: ProfilerPaths reads Main.SavePath, LegacyJsonImporter
         imports legacy JSON via game-runtime calls, ProfilerCompactCommand
         is a tModLoader ModCommand, ModlistFingerprint reads HookInterceptor.
         The Terraria-free constants live in PersistenceFileNames so the
         tests reach those without dragging in the game runtime. -->
    <Compile Remove="..\Persistence\ProfilerPaths.cs" />
    <Compile Remove="..\Persistence\LegacyJsonImporter.cs" />
    <Compile Remove="..\Persistence\ProfilerCompactCommand.cs" />
    <Compile Remove="..\Persistence\ModlistFingerprint.cs" />
    <!-- DbReadModel reads the PerformanceProfiler Mod class's static Database
         property (a Terraria.ModLoader.Mod subclass), so it cannot compile in the
         runtime-free test harness. Its only consumers are the dashboard routers,
         which are integration code excluded here anyway. -->
    <Compile Remove="..\Persistence\DbReadModel.cs" />
    <!-- SessionRecorder (now Persistence/Streams/) + TickDownsampler + ContextTransitionWatcher
         + WorldSnapshotter + PlayerDeathDetector + SessionSummaryLogger all depend
         on MetricCollector + SpikeWindow which transitively pull in HookInterceptor
         and a Terraria entry point. They're integration code; the persistence-layer
         tests exercise the writer + records directly. -->
    <Compile Remove="..\Persistence\Streams\SessionRecorder.cs" />
    <Compile Remove="..\Persistence\TickDownsampler.cs" />
    <Compile Remove="..\Persistence\ContextTransitionWatcher.cs" />
    <Compile Remove="..\Persistence\WorldSnapshotter.cs" />
    <Compile Remove="..\Persistence\PlayerDeathDetector.cs" />
    <Compile Remove="..\Persistence\SessionSummaryLogger.cs" />
    <Compile Remove="..\Persistence\Commands\*.cs" />
    <Compile Remove="..\Persistence\Interactions\*.cs" />
    <Compile Remove="..\Profiling\ProfilerFocusProbe.cs" />
  </ItemGroup>

</Project>
