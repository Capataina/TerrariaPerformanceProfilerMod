<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Non-shipping test harness for pure-logic surfaces (ranking, insight
    promotion, ring buffers, etc.). Lives inside the mod source folder so the
    tests stay next to the code, but is deliberately excluded from the .tmod
    package via build.txt's buildIgnore and from the main project's Compile
    glob via PerformanceProfiler.csproj.

    Run with:
        dotnet test Tests/PerformanceProfiler.Tests.csproj

    This project does NOT import tModLoader.targets — tests only exercise
    pure helpers that have no tModLoader runtime dependency. The handful
    of source files we need are linked in via Compile Include below; we
    deliberately avoid a ProjectReference to the mod project because that
    would drag tModLoader assemblies into the test runner.

    Linked-source paths track the v0.10/v0.11 reorganisation that moved every
    stream-shaped class from Profiling/ into Data/. When you add a test fixture
    for a new pure-logic source file, add the file to the Compile Include list
    at its current Data/ or Profiling/ location AND ensure that file genuinely
    has no Terraria.ModLoader references. If it does, mock the dependency or
    test a lower-level helper instead.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>PerformanceProfiler.Tests</RootNamespace>
    <!-- Don't auto-include parent-directory .cs files; we curate the list below. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- LiteDB shipped via the mod's lib folder; reference the same assembly
         that ships inside the .tmod so the test harness exercises the
         production DLL. -->
    <Reference Include="LiteDB">
      <HintPath>..\lib\LiteDB.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Test files in this folder (includes the folded-in
         HookInstallRetentionDiagnostics.cs — pure System/Xunit, no mod deps). -->
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure-logic source files lifted in from the mod project. Each entry's
         file must have zero Terraria.ModLoader dependencies (verified per add).
         v0.10/v0.11 moved the stream-shaped classes Profiling/ -> Data/; paths
         below point at the current locations (the Events bitsets / flags /
         invasion / boss / mode files stayed in Profiling/Events/). -->
    <Compile Include="..\Profiling\RingBuffer.cs" Link="Source\RingBuffer.cs" />
    <Compile Include="..\Data\Aggregators\PerModSample.cs" Link="Source\PerModSample.cs" />
    <Compile Include="..\Data\Aggregators\PerModAttribution.cs" Link="Source\PerModAttribution.cs" />
    <Compile Include="..\Profiling\TickFrame.cs" Link="Source\TickFrame.cs" />
    <Compile Include="..\Data\Stats\Baseline.cs" Link="Source\Baseline.cs" />
    <Compile Include="..\Data\Detectors\StallDetector.cs" Link="Source\StallDetector.cs" />
    <Compile Include="..\Profiling\Events\BiomeBitset.cs" Link="Source\Events\BiomeBitset.cs" />
    <Compile Include="..\Profiling\Events\WeatherFlags.cs" Link="Source\Events\WeatherFlags.cs" />
    <Compile Include="..\Profiling\Events\InvasionId.cs" Link="Source\Events\InvasionId.cs" />
    <Compile Include="..\Profiling\Events\GameMode.cs" Link="Source\Events\GameMode.cs" />
    <Compile Include="..\Profiling\Events\BossSlotArray.cs" Link="Source\Events\BossSlotArray.cs" />
    <Compile Include="..\Profiling\Events\EventContext.cs" Link="Source\Events\EventContext.cs" />
    <Compile Include="..\Data\Detectors\Insights\InsightRecord.cs" Link="Source\Insights\InsightRecord.cs" />
    <Compile Include="..\Data\Detectors\Insights\InsightStore.cs" Link="Source\Insights\InsightStore.cs" />
    <Compile Include="..\Data\Detectors\Insights\RankingScorer.cs" Link="Source\Insights\RankingScorer.cs" />

    <!-- v0.6 Phase alpha shared infrastructure. LangNameCache and ModOwnerCache
         depend on Terraria.ModLoader so they are NOT lifted; their verification
         is via in-game playtest at wrap-up. The runtime-independent helpers
         (Time, RowPool, ListPool, BoolIndex, EnumStringTable) get exercised
         by xUnit so the per-tick zero-alloc contract is testable. -->
    <Compile Include="..\Profiling\Time.cs" Link="Source\Time.cs" />
    <Compile Include="..\Profiling\Pools\IPoolReset.cs" Link="Source\Pools\IPoolReset.cs" />
    <Compile Include="..\Profiling\Pools\RowPool.cs" Link="Source\Pools\RowPool.cs" />
    <Compile Include="..\Profiling\Pools\ListPool.cs" Link="Source\Pools\ListPool.cs" />
    <Compile Include="..\Profiling\Util\BoolIndex.cs" Link="Source\Util\BoolIndex.cs" />
    <Compile Include="..\Profiling\EnumStringTable.cs" Link="Source\EnumStringTable.cs" />

    <!-- Persistence sources. ProfilerDatabase, records, writer, journal stayed
         under Profiling/Persistence/; the per-collection STREAM classes moved to
         Data/Streams/ in v0.11. ProfilerDatabase references StreamRegistry, so
         Data/Streams/ must be linked. All reference LiteDB only (no tModLoader);
         the streams' inert Data.Collectors / Data.Aggregators.Segments header
         usings resolve against the empty stubs in _TestNamespaceStubs.cs. -->
    <Compile Include="..\Profiling\Persistence\*.cs" Link="Source\Persistence\%(Filename)%(Extension)" />
    <Compile Include="..\Profiling\Persistence\Records\*.cs" Link="Source\Persistence\Records\%(Filename)%(Extension)" />
    <Compile Include="..\Data\Streams\*.cs" Link="Source\Streams\%(Filename)%(Extension)" />
    <!-- Files that reference Terraria types must be excluded from the
         test compile: ProfilerPaths reads Main.SavePath, LegacyJsonImporter
         imports legacy JSON via game-runtime calls, ProfilerCompactCommand
         is a tModLoader ModCommand, ModlistFingerprint reads HookInterceptor.
         The Terraria-free constants live in PersistenceFileNames so the
         tests reach those without dragging in the game runtime. -->
    <Compile Remove="..\Profiling\Persistence\ProfilerPaths.cs" />
    <Compile Remove="..\Profiling\Persistence\LegacyJsonImporter.cs" />
    <Compile Remove="..\Profiling\Persistence\ProfilerCompactCommand.cs" />
    <Compile Remove="..\Profiling\Persistence\ModlistFingerprint.cs" />
    <!-- SessionRecorder (now Data/Streams/) + TickDownsampler + ContextTransitionWatcher
         + WorldSnapshotter + PlayerDeathDetector + SessionSummaryLogger all depend
         on MetricCollector + SpikeWindow which transitively pull in HookInterceptor
         and a Terraria entry point. They're integration code; the persistence-layer
         tests exercise the writer + records directly. -->
    <Compile Remove="..\Data\Streams\SessionRecorder.cs" />
    <Compile Remove="..\Profiling\Persistence\TickDownsampler.cs" />
    <Compile Remove="..\Profiling\Persistence\ContextTransitionWatcher.cs" />
    <Compile Remove="..\Profiling\Persistence\WorldSnapshotter.cs" />
    <Compile Remove="..\Profiling\Persistence\PlayerDeathDetector.cs" />
    <Compile Remove="..\Profiling\Persistence\SessionSummaryLogger.cs" />
    <Compile Remove="..\Profiling\Persistence\Commands\*.cs" />
    <Compile Remove="..\Profiling\Persistence\Interactions\*.cs" />
    <Compile Remove="..\Profiling\ProfilerFocusProbe.cs" />
  </ItemGroup>

</Project>
